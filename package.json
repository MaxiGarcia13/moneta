{
  "name": "moneta",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "description": "A simple and intuitive app to track expenses, manage budgets, and take control of your personal finances.",
  "author": "Maximiliano Garcia Mortigliengo",
  "license": "ISC",
  "keywords": [],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "supabase:types": "source .env && pnpm dlx supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/supabase/database.types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@maxigarcia/eslint-config": "^1.14.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
