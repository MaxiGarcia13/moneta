{
  "name": "moneta",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "description": "A simple and intuitive app to track expenses, manage budgets, and take control of your personal finances.",
  "author": "Maximiliano Garcia Mortigliengo",
  "license": "ISC",
  "keywords": [],
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "supabase:types": "pnpm dlx supabase gen types typescript --project-id \"$(sed -n 's/^VITE_SUPABASE_PROJECT_ID=//p' .env)\" > src/supabase/database.types.ts",
    "clean": "rm -rf .vite dist node_modules pnpm-lock.yaml",
    "phoenix": "pnpm clean && pnpm install && pnpm run build"
  },
  "dependencies": {
    "@maxigarcia/js-utils": "^1.22.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.104.1",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@maxigarcia/eslint-config": "^1.14.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
